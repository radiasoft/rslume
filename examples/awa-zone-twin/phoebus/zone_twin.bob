<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>AWA zone1-&gt;zone2 twin</name>
  <width>1270</width>
  <height>1006</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>AWA zone1 -&gt; zone2 twin (click an element for controls)</text>
    <x>30</x><y>10</y><width>700</width><height>28</height>
    <font><font family="Liberation Sans" style="BOLD" size="16.0"/></font>
  </widget>
  <widget type="label" version="2.0.0">
    <name>StatusLabel</name>
    <text>Twin:</text>
    <x>1010</x><y>12</y><width>50</width><height>22</height>
    <font><font family="Liberation Sans" style="BOLD" size="12.0"/></font>
  </widget>
  <widget type="led" version="2.0.0">
    <name>StatusLed</name>
    <pv_name>pva://$(P=AWA:SIM:)STATUS</pv_name>
    <x>1060</x><y>12</y><width>20</width><height>20</height>
    <off_color><color red="0" green="170" blue="0"/></off_color>
    <on_color><color red="255" green="150" blue="0"/></on_color>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>StatusText</name>
    <pv_name>pva://$(P=AWA:SIM:)STATUS</pv_name>
    <x>1090</x><y>10</y><width>130</width><height>22</height>
    <precision>3</precision>
    <precision_from_pv>false</precision_from_pv>
    <show_units>false</show_units>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>axis</name>
    <x>30</x><y>159</y><width>1200</width><height>2</height>
    <background_color><color red="0" green="0" blue="0"/></background_color>
    <line_width>1</line_width>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>btn_Gun</name>
    <actions>
      <action type="open_display">
        <file>cavity_controls.bob</file>
        <macros><PHASE>Gun_phid</PHASE><POWER>Gun_p_actual</POWER></macros>
        <target>window</target>
        <description>Gun: PHASE=Gun_phid, POWER=Gun_p_actual</description>
      </action>
    </actions>
    <text></text>
    <x>20</x><y>125</y><width>20</width><height>70</height>
    <background_color><color red="220" green="60" blue="60"/></background_color>
    <tooltip>Gun: PHASE=Gun_phid, POWER=Gun_p_actual</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>lbl_Gun</name>
    <text>Gun</text>
    <x>14</x><y>60</y><width>16</width><height>56</height>
    <rotation_step>1</rotation_step>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>btn_SolBF</name>
    <actions>
      <action type="open_display">
        <file>solenoid_controls.bob</file>
        <macros><SCALE>SolBF_scale_factor</SCALE><MIN>0</MIN><MAX>0.0003</MAX><INC>1e-06</INC></macros>
        <target>window</target>
        <description>SolBF: SCALE=SolBF_scale_factor, MIN=0, MAX=0.0003, INC=1e-06</description>
      </action>
    </actions>
    <text></text>
    <x>-8</x><y>125</y><width>10</width><height>70</height>
    <background_color><color red="60" green="120" blue="220"/></background_color>
