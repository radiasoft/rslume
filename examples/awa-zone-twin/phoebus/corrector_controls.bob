<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Corrector controls</name>
  <width>325</width>
  <height>312</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>Corrector</text>
    <x>20</x><y>10</y><width>280</width><height>28</height>
    <font><font family="Liberation Sans" style="BOLD" size="16.0"/></font>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_H</name>
    <text>Horizontal [T.mm]</text>
    <x>20</x><y>50</y><width>160</width><height>25</height>
  </widget>
  <widget type="spinner" version="2.0.0">
    <name>Spinner_H</name>
    <pv_name>pva://$(P=AWA:SIM:)$(H)</pv_name>
    <x>185</x><y>50</y><width>120</width><height>25</height>
    <minimum>-5</minimum>
    <maximum>5</maximum>
    <limits_from_pv>false</limits_from_pv>
    <increment>0.1</increment>
  </widget>
  <widget type="scaledslider" version="2.0.0">
    <name>Slider_H</name>
    <pv_name>pva://$(P=AWA:SIM:)$(H)</pv_name>
    <x>20</x><y>80</y><width>285</width><height>50</height>
    <minimum>-5</minimum>
    <maximum>5</maximum>
    <limits_from_pv>false</limits_from_pv>
    <increment>0.1</increment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>RBLabel_H</name>
    <text>readback:</text>
    <x>20</x><y>140</y><width>80</width><height>20</height>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>RB_H</name>
    <pv_name>pva://$(P=AWA:SIM:)$(H)</pv_name>
    <x>105</x><y>140</y><width>130</width><height>20</height>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_V</name>
    <text>Vertical [T.mm]</text>
    <x>20</x><y>176</y><width>160</width><height>25</height>
  </widget>
  <widget type="spinner" version="2.0.0">
    <name>Spinner_V</name>
    <pv_name>pva://$(P=AWA:SIM:)$(V)</pv_name>
    <x>185</x><y>176</y><width>120</width><height>25</height>
    <minimum>-5</minimum>
    <maximum>5</maximum>
    <limits_from_pv>false</limits_from_pv>
    <increment>0.1</increment>
  </widget>
  <widget type="scaledslider" version="2.0.0">
    <name>Slider_V</name>
    <pv_name>pva://$(P=AWA:SIM:)$(V)</pv_name>
    <x>20</x><y>206</y><width>285</width><height>50</height>
    <minimum>-5</minimum>
    <maximum>5</maximum>
    <limits_from_pv>false</limits_from_pv>
    <increment>0.1</increment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>RBLabel_V</name>
    <text>readback:</text>
    <x>20</x><y>266</y><width>80</width><height>20</height>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>RB_V</name>
    <pv_name>pva://$(P=AWA:SIM:)$(V)</pv_name>
    <x>105</x><y>266</y><width>130</width><height>20</height>
  </widget>
</display>
